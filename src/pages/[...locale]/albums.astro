---
import MainPageLayout from '@layouts/MainPageLayout.astro'
import Cover from '@components/Cover.astro'
import FabMenu from '@components/control/FabMenu.astro'
import AlbumCard from '@components/albums/AlbumCard.astro'
import { siteConfig } from '@/config'
import i18nit from '@i18n/translation'
import { i18n } from "astro:config/client";
import { scanAlbums } from '@utils/album-scanner'

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const albumsData = await scanAlbums();

// 收集所有标签用于筛选
const allTags = [...new Set(albumsData.flatMap((a) => a.tags || []))].sort();

const pageTitle = `相册 - ${siteConfig.title}`;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
	<div class="w-full px-4 sm:px-6 lg:px-8 py-8">
		<Cover title="相册" subTitle="记录生活中的美好瞬间"/>
		
		<div class="mt-8 max-w-6xl mx-auto">
			<div class="bg-[var(--card-color)] border border-[var(--button-border-color)] rounded-xl overflow-hidden">
				<div class="p-6 border-b border-[var(--button-border-color)]">
					<div class="flex items-center gap-3 mb-2">
						<svg class="w-6 h-6 text-[var(--link-color)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
						</svg>
						<h1 class="text-xl font-bold text-[var(--text-color)]">我的相册</h1>
					</div>
					<p class="text-sm text-[var(--text-color-70)]">
						共 {albumsData.length} 个相册，{albumsData.reduce((sum, a) => sum + a.photos.length, 0)} 张照片
					</p>
				</div>

				<!-- 标签筛选 -->
				{allTags.length > 0 && (
					<div class="px-6 py-4 border-b border-[var(--button-border-color)]">
						<div class="flex flex-wrap gap-2" id="album-tags">
							<button
								class="tag-filter px-3 py-1.5 text-sm rounded-full bg-[var(--link-color)] text-white transition-colors"
								data-tag=""
							>
								全部
							</button>
							{allTags.map((tag: string) => (
								<button
									class="tag-filter px-3 py-1.5 text-sm rounded-full bg-[var(--button-hover-color)] text-[var(--text-color-70)] hover:bg-[var(--button-hover-color)] transition-colors"
									data-tag={tag}
								>
									{tag}
								</button>
							))}
						</div>
					</div>
				)}

				<!-- 相册网格 -->
				<div class="p-6">
					{albumsData.length > 0 ? (
						<div id="albums-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
							{albumsData.map((album) => (
								<AlbumCard album={album} />
							))}
						</div>
					) : (
						<div class="text-center py-16">
							<div class="w-16 h-16 mx-auto mb-4 rounded-full bg-[var(--button-hover-color)] flex items-center justify-center">
								<svg class="w-8 h-8 text-[var(--text-color-50)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
								</svg>
							</div>
							<h3 class="text-lg font-medium text-[var(--text-color)] mb-2">暂无相册</h3>
							<p class="text-[var(--text-color-50)]">在 public/images/albums/ 目录下添加相册文件夹</p>
						</div>
					)}
				</div>
			</div>
		</div>
	</div>
	<FabMenu showBackBottom={true} />
</MainPageLayout>

<script>
	// 标签筛选功能
	const tagButtons = document.querySelectorAll('#album-tags .tag-filter');
	const albumCards = document.querySelectorAll('#albums-grid .album-card');

	tagButtons.forEach((btn: Element) => {
		btn.addEventListener('click', () => {
			const selectedTag = (btn as HTMLElement).dataset.tag || '';

			// 更新按钮样式
			tagButtons.forEach((b: Element) => {
				b.classList.remove('bg-[var(--link-color)]', 'text-white');
				b.classList.add('bg-[var(--button-hover-color)]', 'text-[var(--text-color-70)]');
			});
			btn.classList.remove('bg-[var(--button-hover-color)]', 'text-[var(--text-color-70)]');
			btn.classList.add('bg-[var(--link-color)]', 'text-white');

			// 筛选相册
			albumCards.forEach((card: Element) => {
				const cardTags = (card as HTMLElement).dataset.tags || '';
				if (!selectedTag || cardTags.split(',').includes(selectedTag)) {
					card.classList.remove('hidden');
					card.classList.remove('filtered-out');
				} else {
					card.classList.add('hidden');
					card.classList.add('filtered-out');
				}
			});
		});
	});
</script>
