---
export const prerender = true;

import MainPageLayout from '@layouts/MainPageLayout.astro'
import Cover from '@components/Cover.astro'
import FabMenu from '@components/control/FabMenu.astro'
import { siteConfig } from '@/config'
import i18nit from '@i18n/translation'
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
	return i18n?.locales.map(locale => ({ params: { locale: locale == i18n?.defaultLocale ? undefined : (locale as string) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);

const pageTitle = `课程表 - ${siteConfig.title}`;
---

<MainPageLayout title={pageTitle} lang={currentLang}>
	<div class="w-full px-4 sm:px-6 lg:px-8 py-8">
		<Cover title="课程表" subTitle=""/>
		
		<div class="mt-8" id="timetable-container">
			<!-- 头部信息 -->
			<div class="mb-6">
				<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
					<div>
						<h1 class="text-2xl sm:text-3xl font-bold text-[var(--text-color)] mb-2" id="table-name">加载中...</h1>
						<div class="flex items-center gap-2 text-sm text-[var(--text-color-70)]">
							<span id="max-week">共 20 周</span>
						</div>
					</div>
					<a href="/" class="inline-flex items-center justify-center px-4 py-2 bg-[var(--card-color)] border border-[var(--button-border-color)] rounded-lg text-[var(--text-color)] hover:bg-[var(--button-hover-color)] transition-colors">
						<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
						</svg>
						返回首页
					</a>
				</div>

				<!-- 周选择器 -->
				<div class="flex flex-wrap items-center gap-3">
					<div class="inline-flex items-center gap-1 bg-[var(--card-color)] border border-[var(--button-border-color)] rounded-lg p-1">
						<button 
							id="prev-week-btn"
							class="w-8 h-8 flex items-center justify-center rounded-md transition-colors text-[var(--text-color)] hover:bg-[var(--button-hover-color)]"
							disabled
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
							</svg>
						</button>
						<span class="min-w-[4.5rem] px-3 text-center font-medium text-[var(--text-color)]" id="current-week-display">
							第 1 周
						</span>
						<button 
							id="next-week-btn"
							class="w-8 h-8 flex items-center justify-center rounded-md transition-colors text-[var(--text-color)] hover:bg-[var(--button-hover-color)]"
							disabled
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
							</svg>
						</button>
					</div>
					<span id="current-week-badge" class="hidden px-3 py-1 text-sm font-medium bg-[var(--link-color)] text-white rounded-full">
						当前周
					</span>
				</div>
			</div>

			<!-- 桌面端网格视图 -->
			<div class="hidden md:block mb-8" id="desktop-view">
				<div class="bg-[var(--card-color)] border border-[var(--button-border-color)] rounded-xl overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full table-fixed" id="timetable-table">
							<thead id="timetable-head">
							</thead>
							<tbody id="timetable-body">
							</tbody>
						</table>
					</div>
				</div>
			</div>

			<!-- 移动端列表视图 -->
			<div class="md:hidden space-y-4" id="mobile-view">
			</div>
		</div>
	</div>
	<FabMenu showBackBottom={true} />
</MainPageLayout>

<script>
// 类型定义
interface TimetableNodeTime {
	node: number;
	startTime: string;
	endTime: string;
	timeTable: number;
}

interface TimetableCourseDefinition {
	id: number;
	courseName: string;
	color?: string;
}

interface TimetableCourseArrangement {
	id: number;
	day: number;
	startNode: number;
	step: number;
	startWeek: number;
	endWeek: number;
	teacher?: string;
	room?: string;
}

interface WeekendDisplay {
	enabled: boolean;
	weeks: number[];
	days: string[];
}

interface TimetableSettings {
	maxWeek: number;
	nodes: number;
	startDate: string;
	showSat: boolean;
	showSun: boolean;
	weekendDisplay?: WeekendDisplay;
	tableName: string;
}

interface TimetableData {
	timeTable: TimetableNodeTime[];
	courses: TimetableCourseDefinition[];
	schedules: TimetableCourseArrangement[];
	settings: TimetableSettings;
}

interface TimetableCourseView {
	courseId: number;
	courseName: string;
	color: string;
	teacher: string;
	room: string;
	day: number;
	startNode: number;
	endNode: number;
	durationNodes: number;
	startWeek: number;
	endWeek: number;
	nodeText: string;
	timeText: string;
}

interface TimetableDayColumn {
	day: number;
	label: string;
}

interface TimetableNodeRow {
	node: number;
	startTime: string;
	endTime: string;
}

interface TimetableViewModel {
	tableName: string;
	maxWeek: number;
	currentWeek: number;
	weeks: number[];
	dayColumns: TimetableDayColumn[];
	nodeRows: TimetableNodeRow[];
	coursesByDay: Record<number, TimetableCourseView[]>;
}

const WEEKDAY_LABELS: Record<number, string> = {
	1: '周一',
	2: '周二',
	3: '周三',
	4: '周四',
	5: '周五',
	6: '周六',
	7: '周日'
};

// 解析 ARGB 颜色
function parseArgbColor(raw: string): string | null {
	if (!raw || !raw.startsWith('#') || raw.length !== 9) return null;
	const r = raw.slice(3, 5);
	const g = raw.slice(5, 7);
	const b = raw.slice(7, 9);
	return `#${r}${g}${b}`;
}

// 哈希函数
function hashText(input: string): number {
	let hash = 0;
	for (let i = 0; i < input.length; i += 1) {
		hash = (hash * 31 + input.charCodeAt(i)) | 0;
	}
	return Math.abs(hash);
}

// 构建课程颜色
function buildCourseColor(courseName: string, courseId: number, rawColor?: string): string {
	const parsed = parseArgbColor(rawColor ?? '');
	if (parsed) return parsed;
	const seed = hashText(`${courseName}-${courseId}`);
	const hue = seed % 360;
	return `hsl(${hue} 78% 68%)`;
}

// 解析日期
function parseDateFromYmd(ymd: string): Date | null {
	const parts = ymd.split('-').map((part) => Number(part));
	if (parts.length !== 3 || parts.some((part) => !Number.isFinite(part))) {
		return null;
	}
	const [year, month, day] = parts;
	return new Date(year, month - 1, day);
}

// 计算当前周
function resolveCurrentWeek(startDateText: string, maxWeek: number, now: Date = new Date()): number {
	const startDate = parseDateFromYmd(startDateText);
	if (!startDate) {
		return 1;
	}

	const msPerDay = 24 * 60 * 60 * 1000;
	const diffDays = Math.floor((now.getTime() - startDate.getTime()) / msPerDay);
	const week = Math.floor(diffDays / 7) + 1;

	if (week < 1) {
		return 1;
	}
	if (week > maxWeek) {
		return maxWeek;
	}
	return week;
}

// 获取节点行
function toNodeRows(data: TimetableData): TimetableNodeRow[] {
	const rows = data.timeTable
		.filter((item) => item.node >= 1 && item.node <= data.settings.nodes)
		.sort((a, b) => a.node - b.node)
		.map((item) => ({
			node: item.node,
			startTime: item.startTime,
			endTime: item.endTime
		}));

	if (rows.length > 0) {
		return rows;
	}

	return Array.from({ length: data.settings.nodes }, (_, index) => {
		const node = index + 1;
		return {
			node,
			startTime: '--:--',
			endTime: '--:--'
		};
	});
}

// 检查是否应该显示周末
function shouldShowWeekend(data: TimetableData, currentWeek: number): { showSat: boolean; showSun: boolean } {
	const weekendDisplay = data.settings.weekendDisplay;
	
	if (!weekendDisplay || !weekendDisplay.enabled) {
		return {
			showSat: data.settings.showSat,
			showSun: data.settings.showSun
		};
	}
	
	const isTargetWeek = weekendDisplay.weeks.includes(currentWeek);
	
	if (!isTargetWeek) {
		return { showSat: false, showSun: false };
	}
	
	const showSat = weekendDisplay.days.includes('sat');
	const showSun = weekendDisplay.days.includes('sun');
	
	return { showSat, showSun };
}

// 获取日期列
function toDayColumns(data: TimetableData, currentWeek: number): TimetableDayColumn[] {
	const columns: TimetableDayColumn[] = [
		{ day: 1, label: WEEKDAY_LABELS[1] },
		{ day: 2, label: WEEKDAY_LABELS[2] },
		{ day: 3, label: WEEKDAY_LABELS[3] },
		{ day: 4, label: WEEKDAY_LABELS[4] },
		{ day: 5, label: WEEKDAY_LABELS[5] }
	];

	const { showSat, showSun } = shouldShowWeekend(data, currentWeek);

	if (showSat) {
		columns.push({ day: 6, label: WEEKDAY_LABELS[6] });
	}
	if (showSun) {
		columns.push({ day: 7, label: WEEKDAY_LABELS[7] });
	}
	return columns;
}

// 构建课程视图
function toCourseView(
	arrangement: TimetableCourseArrangement,
	courseName: string,
	color: string,
	nodeRows: TimetableNodeRow[]
): TimetableCourseView {
	const durationNodes = arrangement.step;
	const maxNode = Math.max(...nodeRows.map((row) => row.node), arrangement.startNode);
	const endNode = Math.min(arrangement.startNode + durationNodes - 1, maxNode);
	const startNodeRow = nodeRows.find((row) => row.node === arrangement.startNode);
	const endNodeRow = nodeRows.find((row) => row.node === endNode);
	const startTime = startNodeRow?.startTime ?? '--:--';
	const endTime = endNodeRow?.endTime ?? '--:--';

	return {
		courseId: arrangement.id,
		courseName,
		color,
		teacher: arrangement.teacher?.trim() || '未填写',
		room: arrangement.room?.trim() || '未填写',
		day: arrangement.day,
		startNode: arrangement.startNode,
		endNode,
		durationNodes,
		startWeek: arrangement.startWeek,
		endWeek: arrangement.endWeek,
		nodeText: `第 ${arrangement.startNode}-${endNode} 节`,
		timeText: `${startTime} - ${endTime}`
	};
}

// 构建视图模型
function buildTimetableViewModel(data: TimetableData, selectedWeek: number): TimetableViewModel {
	const maxWeek = Math.max(1, data.settings.maxWeek || 1);
	const week = Math.min(Math.max(1, selectedWeek), maxWeek);
	const nodeRows = toNodeRows(data);
	const dayColumns = toDayColumns(data, week);

	const courseMap = new Map(data.courses.map((course) => [course.id, course]));

	const coursesByDay: Record<number, TimetableCourseView[]> = {};
	for (const column of dayColumns) {
		coursesByDay[column.day] = [];
	}

	for (const arrangement of data.schedules) {
		if (arrangement.day < 1 || arrangement.day > 7) {
			continue;
		}
		if (week < arrangement.startWeek || week > arrangement.endWeek) {
			continue;
		}
		if (!(arrangement.day in coursesByDay)) {
			continue;
		}

		const courseDef = courseMap.get(arrangement.id);
		const courseName = courseDef?.courseName ?? `课程 #${arrangement.id}`;
		const color = buildCourseColor(courseName, arrangement.id, courseDef?.color);
		coursesByDay[arrangement.day].push(toCourseView(arrangement, courseName, color, nodeRows));
	}

	for (const day of Object.keys(coursesByDay)) {
		coursesByDay[Number(day)].sort(
			(a, b) => a.startNode - b.startNode || a.courseName.localeCompare(b.courseName)
		);
	}

	return {
		tableName: data.settings.tableName || '课表',
		maxWeek,
		currentWeek: week,
		weeks: Array.from({ length: maxWeek }, (_, index) => index + 1),
		dayColumns,
		nodeRows,
		coursesByDay
	};
}

// 全局状态
let timetableData: TimetableData | null = null;
let currentWeek = 1;
let selectedWeek = 1;
let viewModel: TimetableViewModel | null = null;

// 渲染桌面端视图
function renderDesktopView() {
	if (!viewModel) return;
	
	const table = document.getElementById('timetable-table');
	const thead = document.getElementById('timetable-head');
	const tbody = document.getElementById('timetable-body');
	
	if (!table || !thead || !tbody) return;
	
	// 设置 colgroup
	const colgroup = document.createElement('colgroup');
	const timeCol = document.createElement('col');
	timeCol.className = 'w-28';
	colgroup.appendChild(timeCol);
	
	viewModel.dayColumns.forEach(() => {
		const col = document.createElement('col');
		colgroup.appendChild(col);
	});
	
	// 清空并重新设置表格
	table.innerHTML = '';
	table.appendChild(colgroup);
	table.appendChild(thead);
	table.appendChild(tbody);
	
	// 渲染表头
	thead.innerHTML = `
		<tr class="border-b border-[var(--button-border-color)]">
			<th class="px-4 py-3 text-left text-sm font-semibold text-[var(--text-color)] bg-[var(--button-hover-color)]">节次</th>
			${viewModel.dayColumns.map(day => `
				<th class="px-4 py-3 text-left text-sm font-semibold text-[var(--text-color)] bg-[var(--button-hover-color)]">${day.label}</th>
			`).join('')}
		</tr>
	`;
	
	// 渲染表体
	if (!viewModel) return;
	const oddRows = viewModel.nodeRows.filter(row => row.node % 2 === 1);
	tbody.innerHTML = oddRows.map(row => {
		const endNode = Math.min(row.node + 1, viewModel!.nodeRows.length);
		const endNodeRow = viewModel!.nodeRows.find(item => item.node === endNode);
		
		return `
			<tr class="border-b border-[var(--button-border-color)] last:border-b-0">
				<td class="px-4 py-3 align-top bg-[var(--button-hover-color)]/50">
					<p class="text-sm font-medium text-[var(--text-color)]">第 ${row.node}-${endNode} 节</p>
					<p class="text-xs text-[var(--text-color-50)] mt-1">
						${row.startTime} - ${endNodeRow?.endTime ?? row.endTime}
					</p>
				</td>
				${viewModel!.dayColumns.map(day => {
				const courses = (viewModel!.coursesByDay[day.day] ?? []).filter(c => c.startNode === row.node);
					if (courses.length === 0) {
						return `<td class="px-4 py-3 align-top"><div class="text-center text-xs text-[var(--text-color-50)]">—</div></td>`;
					}
					return `
						<td class="px-4 py-3 align-top">
							<div class="space-y-2">
								${courses.map(course => `
									<div
										class="rounded-lg border-l-4 p-3 text-sm break-words"
										style="border-color: ${course.color}; background: color-mix(in srgb, ${course.color} 10%, transparent)"
									>
										<div class="font-semibold mb-1 text-[var(--text-color)]">${course.courseName}</div>
										<div class="text-xs text-[var(--text-color-70)] space-y-0.5">
											<div>${course.startWeek}-${course.endWeek}周</div>
											<div>教室：${course.room}</div>
											<div>教师：${course.teacher}</div>
										</div>
									</div>
								`).join('')}
							</div>
						</td>
					`;
				}).join('')}
			</tr>
		`;
	}).join('');
}

// 渲染移动端视图
function renderMobileView() {
	if (!viewModel) return;
	
	const container = document.getElementById('mobile-view');
	if (!container) return;
	
	container.innerHTML = viewModel!.dayColumns.map(day => {
		const courses = viewModel!.coursesByDay[day.day] ?? [];
		return `
			<div class="bg-[var(--card-color)] border border-[var(--button-border-color)] rounded-xl overflow-hidden">
				<div class="px-4 py-3 border-b border-[var(--button-border-color)] bg-[var(--button-hover-color)]">
					<h3 class="text-lg font-semibold text-[var(--text-color)]">${day.label}</h3>
				</div>
				<div class="p-4">
					${courses.length > 0 ? `
						<div class="space-y-3">
							${courses.map(course => `
								<div
									class="rounded-lg border-l-4 p-3"
									style="border-color: ${course.color}; background: color-mix(in srgb, ${course.color} 10%, transparent)"
								>
									<div class="font-semibold mb-2 text-[var(--text-color)]">${course.courseName}</div>
									<div class="text-sm text-[var(--text-color-70)] space-y-1">
										<div>时间：${course.timeText}</div>
										<div>周次：${course.startWeek}-${course.endWeek}周</div>
										<div>教室：${course.room}</div>
										<div>教师：${course.teacher}</div>
									</div>
								</div>
							`).join('')}
						</div>
					` : `<p class="text-sm text-[var(--text-color-50)]">本周暂无课程</p>`}
				</div>
			</div>
		`;
	}).join('');
}

// 更新 UI
function updateUI() {
	if (!viewModel) return;
	
	// 更新标题
	const tableNameEl = document.getElementById('table-name');
	if (tableNameEl) tableNameEl.textContent = viewModel.tableName;
	
	// 更新副标题
	const maxWeekEl = document.getElementById('max-week');
	if (maxWeekEl) maxWeekEl.textContent = `共 ${viewModel.maxWeek} 周`;
	
	// 更新周显示
	const weekDisplayEl = document.getElementById('current-week-display');
	if (weekDisplayEl) weekDisplayEl.textContent = `第 ${viewModel.currentWeek} 周`;
	
	// 更新封面副标题
	const coverSubtitle = document.querySelector('.cover-subtitle');
	if (coverSubtitle) coverSubtitle.textContent = `第 ${viewModel.currentWeek} 周`;
	
	// 更新按钮状态
	const prevBtn = document.getElementById('prev-week-btn') as HTMLButtonElement;
	const nextBtn = document.getElementById('next-week-btn') as HTMLButtonElement;
	
	if (prevBtn) {
		prevBtn.disabled = viewModel.currentWeek <= 1;
		prevBtn.className = `w-8 h-8 flex items-center justify-center rounded-md transition-colors ${
			viewModel.currentWeek <= 1 
				? 'text-[var(--text-color-30)] cursor-not-allowed' 
				: 'text-[var(--text-color)] hover:bg-[var(--button-hover-color)]'
		}`;
	}
	
	if (nextBtn) {
		nextBtn.disabled = viewModel.currentWeek >= viewModel.maxWeek;
		nextBtn.className = `w-8 h-8 flex items-center justify-center rounded-md transition-colors ${
			viewModel.currentWeek >= viewModel.maxWeek 
				? 'text-[var(--text-color-30)] cursor-not-allowed' 
				: 'text-[var(--text-color)] hover:bg-[var(--button-hover-color)]'
		}`;
	}
	
	// 更新当前周标记
	const badgeEl = document.getElementById('current-week-badge');
	if (badgeEl) {
		if (viewModel.currentWeek === currentWeek) {
			badgeEl.classList.remove('hidden');
		} else {
			badgeEl.classList.add('hidden');
		}
	}
	
	// 渲染表格
	renderDesktopView();
	renderMobileView();
}

// 切换到指定周
function goToWeek(week: number) {
	if (!timetableData) return;
	if (week < 1 || week > timetableData.settings.maxWeek) return;
	
	selectedWeek = week;
	viewModel = buildTimetableViewModel(timetableData, selectedWeek);
	
	// 更新 URL（不刷新页面）
	const url = new URL(window.location.href);
	if (week === currentWeek) {
		url.searchParams.delete('week');
	} else {
		url.searchParams.set('week', String(week));
	}
	window.history.replaceState({}, '', url);
	
	updateUI();
}

// 初始化
async function init() {
	try {
		// 加载数据
		const response = await fetch('/timetable/大三下.json');
		timetableData = await response.json();
		
		// 计算当前周
		if (!timetableData) return;
		currentWeek = resolveCurrentWeek(timetableData.settings.startDate, timetableData.settings.maxWeek);
		
		// 从 URL 获取选中的周
		const url = new URL(window.location.href);
		const requestedWeek = Number(url.searchParams.get('week'));
		if (Number.isInteger(requestedWeek) && requestedWeek > 0) {
			selectedWeek = requestedWeek;
		} else {
			selectedWeek = currentWeek;
		}
		
		// 构建视图模型
		viewModel = buildTimetableViewModel(timetableData!, selectedWeek);
		
		// 绑定事件
		const prevBtn = document.getElementById('prev-week-btn');
		const nextBtn = document.getElementById('next-week-btn');
		
		if (prevBtn) {
			prevBtn.addEventListener('click', () => goToWeek(selectedWeek - 1));
		}
		
		if (nextBtn) {
			nextBtn.addEventListener('click', () => goToWeek(selectedWeek + 1));
		}
		
		// 初始渲染
		updateUI();
	} catch (error) {
		console.error('加载课程表失败:', error);
		document.getElementById('table-name')!.textContent = '加载失败';
	}
}

// 页面加载完成后初始化
document.addEventListener('DOMContentLoaded', init);

// Astro 页面导航后重新初始化
document.addEventListener('astro:page-load', init);
</script>
