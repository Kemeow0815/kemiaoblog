<script>
    const VISIT_SESSION_KEY = 'blog_visit_flag';
    let hasShownToast = false;

    function createWelcomeToast() {
        const toast = document.createElement('div');
        toast.id = 'welcome-toast';
        toast.className = 'welcome-toast-hidden';
        toast.innerHTML = `
            <div class="welcome-toast-card">
                <div class="welcome-toast-content">
                    <div class="welcome-toast-icon">👋</div>
                    <div class="welcome-toast-body">
                        <p id="welcome-message" class="welcome-toast-title">
                            正在加载...
                        </p>
                        <p id="welcome-stats" class="welcome-toast-stats">

                        </p>
                        <p class="welcome-toast-quote">
                            在茫茫互联网的大海中 感谢遇见你🙏
                        </p>
                        <div class="welcome-toast-links">
                            <a href="https://t.me/kemiaochat" target="_blank" rel="noopener noreferrer" class="welcome-link welcome-link-primary">
                                👆加群
                            </a>
                            <span class="welcome-link-divider">|</span>
                            <a href="https://github.com/Kemeow0815/kemiaoblog/issues/1" target="_blank" rel="noopener noreferrer" class="welcome-link welcome-link-success">
                                📬订阅更新
                            </a>
                            <span class="welcome-link-divider">|</span>
                            <a href="javascript:void(0)" onclick="copyRssLink()" class="welcome-link welcome-link-warning">
                                📋RSS
                            </a>
                        </div>
                        <p id="rss-copy-msg" class="welcome-toast-copy-msg hidden">已复制到剪贴板~</p>
                    </div>
                    <button
                        onclick="closeWelcomeToast()"
                        class="welcome-toast-close"
                        aria-label="关闭"
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>
        `;
        document.body.appendChild(toast);
        return toast;
    }

    function closeWelcomeToast() {
        const toast = document.getElementById('welcome-toast');
        if (toast) {
            toast.classList.remove('welcome-toast-visible');
            toast.classList.add('welcome-toast-hidden');
            setTimeout(() => {
                toast.remove();
            }, 500);
        }
    }

    async function fetchLocation() {
        try {
            const response = await fetch('https://v2.xxapi.cn/api/ip');
            const data = await response.json();

            if (data.code === 200 && data.data) {
                const location = data.data;
                const locationText = `HI 来自${location.address}的朋友`;

                const messageEl = document.getElementById('welcome-message');
                if (messageEl) {
                    messageEl.textContent = locationText;
                }
            }
        } catch (error) {
            console.error('Failed to fetch location:', error);
            const messageEl = document.getElementById('welcome-message');
            if (messageEl) {
                messageEl.textContent = 'HI 来自远方的朋友';
            }
        }
    }

    async function fetchStats() {
        // 等待卜算子数据加载
        let attempts = 0;
        const maxAttempts = 50; // 最多等待5秒

        while (attempts < maxAttempts) {
            const busuanziEl = document.getElementById('busuanzi_site_uv');
            if (busuanziEl && busuanziEl.textContent && busuanziEl.textContent !== '0') {
                const visitorCount = busuanziEl.textContent;
                const statsText = `欢迎 我是克喵 你是本站迎来的第${visitorCount}位访客`;

                const statsEl = document.getElementById('welcome-stats');
                if (statsEl) {
                    statsEl.textContent = statsText;
                }
                return;
            }
            await new Promise(resolve => setTimeout(resolve, 100));
            attempts++;
        }

        // 如果卜算子数据未加载，显示默认文本
        const statsEl = document.getElementById('welcome-stats');
        if (statsEl) {
            statsEl.textContent = '欢迎 我是克喵';
        }
    }

    async function showWelcomeToast() {
        if (hasShownToast) return;

        const toast = createWelcomeToast();

        // 触发动画
        requestAnimationFrame(() => {
            toast.classList.remove('welcome-toast-hidden');
            toast.classList.add('welcome-toast-visible');
        });

        hasShownToast = true;

        // 并行加载数据
        await Promise.all([fetchLocation(), fetchStats()]);

        // 5秒后自动关闭
        setTimeout(() => {
            closeWelcomeToast();
        }, 5000);
    }

    function shouldShowWelcome() {
        return !sessionStorage.getItem(VISIT_SESSION_KEY);
    }

    function markAsVisited() {
        sessionStorage.setItem(VISIT_SESSION_KEY, 'true');
    }

    // 页面加载时显示欢迎弹窗
    function initWelcomeToast() {
        if (shouldShowWelcome()) {
            markAsVisited();
            showWelcomeToast();
        }
    }

    // 初始化和页面切换后都执行
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initWelcomeToast);
    } else {
        initWelcomeToast();
    }

    // 支持 Astro 页面切换
    document.addEventListener('astro:page-load', initWelcomeToast);

    // 暴露到全局
    (window as any).closeWelcomeToast = closeWelcomeToast;

    (window as any).copyRssLink = async () => {
        const msg = document.getElementById('rss-copy-msg') as HTMLElement;
        const rssUrl = window.location.origin + '/rss.xml';
        try {
            await navigator.clipboard.writeText(rssUrl);
            msg.classList.remove('hidden');
            setTimeout(() => msg.classList.add('hidden'), 2000);
        } catch (e) {
            const input = document.createElement('input');
            input.value = rssUrl;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            msg.classList.remove('hidden');
            setTimeout(() => msg.classList.add('hidden'), 2000);
        }
    };
</script>

<style is:global>
    /* 弹窗容器 */
    #welcome-toast {
        position: fixed;
        bottom: 1rem;
        right: 1rem;
        z-index: 9999;
        max-width: calc(100vw - 2rem);
        transition: transform 0.5s ease-out, opacity 0.5s ease-out;
    }

    /* 隐藏状态 */
    .welcome-toast-hidden {
        transform: translateY(100%);
        opacity: 0;
        pointer-events: none;
    }

    /* 显示状态 */
    .welcome-toast-visible {
        transform: translateY(0);
        opacity: 1;
        pointer-events: auto;
    }

    /* 卡片样式 */
    .welcome-toast-card {
        background: linear-gradient(135deg, rgba(0, 59, 110, 0.08) 0%, rgba(87, 172, 231, 0.08) 100%);
        border: 1px solid var(--button-border-color);
        border-radius: 12px;
        box-shadow: 0 10px 40px var(--shadow-color);
        padding: 1rem;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    [data-theme="dark"] .welcome-toast-card {
        background: linear-gradient(135deg, rgba(0, 59, 110, 0.25) 0%, rgba(87, 172, 231, 0.15) 100%);
        border-color: var(--button-border-color);
    }

    /* 内容布局 */
    .welcome-toast-content {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    /* 图标 */
    .welcome-toast-icon {
        flex-shrink: 0;
        font-size: 1.5rem;
        line-height: 1;
    }

    /* 主体内容 */
    .welcome-toast-body {
        flex: 1;
        min-width: 0;
    }

    /* 标题 */
    .welcome-toast-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-color);
        margin: 0;
        line-height: 1.4;
    }

    /* 统计信息 */
    .welcome-toast-stats {
        font-size: 0.75rem;
        color: var(--text-color-70);
        margin: 0.25rem 0 0 0;
        line-height: 1.4;
    }

    /* 引用语 */
    .welcome-toast-quote {
        font-size: 0.75rem;
        color: var(--text-color-70);
        margin: 0.5rem 0 0 0;
        font-style: italic;
        line-height: 1.4;
    }

    /* 链接区域 */
    .welcome-toast-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.5rem;
        flex-wrap: wrap;
    }

    /* 链接样式 */
    .welcome-link {
        font-size: 0.75rem;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s ease;
        cursor: pointer;
    }

    .welcome-link-primary {
        color: var(--link-color);
    }

    .welcome-link-primary:hover {
        color: var(--link-color);
        filter: brightness(1.2);
    }

    .welcome-link-success {
        color: #059669;
    }

    [data-theme="dark"] .welcome-link-success {
        color: #34d399;
    }

    .welcome-link-success:hover {
        filter: brightness(1.2);
    }

    .welcome-link-warning {
        color: #d97706;
    }

    [data-theme="dark"] .welcome-link-warning {
        color: #fbbf24;
    }

    .welcome-link-warning:hover {
        filter: brightness(1.2);
    }

    /* 分隔符 */
    .welcome-link-divider {
        color: var(--button-border-color);
        font-size: 0.75rem;
    }

    /* 复制提示 */
    .welcome-toast-copy-msg {
        font-size: 0.75rem;
        color: #059669;
        margin: 0.25rem 0 0 0;
    }

    [data-theme="dark"] .welcome-toast-copy-msg {
        color: #34d399;
    }

    .hidden {
        display: none;
    }

    /* 关闭按钮 */
    .welcome-toast-close {
        flex-shrink: 0;
        background: none;
        border: none;
        padding: 0.25rem;
        cursor: pointer;
        color: var(--text-color-70);
        transition: color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 4px;
    }

    .welcome-toast-close:hover {
        color: var(--text-color);
        background-color: var(--button-hover-color);
    }

    /* 移动端适配 */
    @media (max-width: 640px) {
        #welcome-toast {
            left: 50%;
            right: auto;
            bottom: 1rem;
            width: 90%;
            max-width: none;
        }

        .welcome-toast-hidden {
            transform: translateX(-50%) translateY(100%);
        }

        .welcome-toast-visible {
            transform: translateX(-50%) translateY(0);
        }

        .welcome-toast-card {
            padding: 0.875rem;
        }
    }

    /* 小屏幕优化 */
    @media (max-width: 380px) {
        .welcome-toast-links {
            gap: 0.375rem;
        }

        .welcome-link {
            font-size: 0.7rem;
        }

        .welcome-link-divider {
            font-size: 0.7rem;
        }
    }
</style>
